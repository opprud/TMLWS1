# ==========================================================================
#  TMLWS1 — public course repo. This .gitignore keeps internal, client-named,
#  and permission-bound material OUT of the public history. These files stay
#  on the instructor's disk (authoring source) but are never committed.
#  Before every `git add`, sanity-check with:  git status --porcelain
# ==========================================================================

# --- Internal working / planning docs (client name, review notes) ---------
/CLAUDE.md
/course-plan.md
/content-inventory.md
/augmentation-geron.md
/augmentation-reddi.md
/review-pedagogy.md
/review-technical.md
/TODOs_MOJ.md

# --- Permission-bound HarvardX / edX (Reddi) material — NEVER distribute ---
/reddi-slides.zip
/reddi-index.tsv
/.reddi-tmp/

# --- Old Brightspace / Particle-era source export (not for distribution) ---
/brightspace-export/

# --- Deck build inputs and intermediates ------------------------------------
# GitHub carries the Marp sources (decks/*.md) and the rendered PDFs
# (decks/pdf/). The figures and the theme stay on the instructor's disk —
# they are only needed to re-render, and decks/assets/reddi/ is permission-
# bound material that must never be published.
decks/assets/
decks/themes/
decks/rendered/
*.pptx

# --- PlatformIO / build artifacts ------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
*.elf
*.hex
*.bin
*.o
*.a

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/

# --- Notebook / model / captured-data artifacts (regenerated in labs) -------
# (Exercise 1.3 saves mnist_dense.keras so it can be opened in Netron.)
*.h5
*.keras
*.tflite
*.pkl
*.npy
*.npz

# --- Datasets: participants download or record their own --------------------
# WISDM is fetched by each participant from
# https://www.cis.fordham.edu/wisdm/dataset.php (setup guide + module 5 README).
# The raw txt alone is 48 MB and it is not ours to redistribute. Fan recordings
# are each participant's own data from the Module 4 rig.
exercises/*/notebooks/Data/
exercises/*/Data/
*.arff

# Lab audio + serial captures (recorded per participant, per desk)
*.wav
exercises/module3-data-forwarding/mic-record/capture*.txt

# --- Generated by the Module 6 emlearn training notebooks -------------------
# xor_model.h is the *output* of xor-train; generating it is the exercise.
exercises/module6-emlearn/xor-train/tmp/
exercises/module6-emlearn/xor-train/xor_model.h
exercises/module6-emlearn/xor-train/xor_data.png
exercises/module6-emlearn/xor-device/include/xor_model.h

# --- Module 6 device-side scratch (emlearn's C compile products, plots) -------
exercises/module6-emlearn/xor-device/tmp/
exercises/module6-emlearn/xor-device/xor_data.png

# --- Module 7: each participant's own fan recordings + what train_rf.py makes -
# The CSVs are recorded on the Module 4 rig (and the .zip is the raw Edge
# Impulse export they came from); fan_model.h / feature_scale.h /
# test_windows.h are that data turned into C — generating them is the exercise.
exercises/module7-models/*.zip
exercises/module7-models/rf-features/data/
exercises/module7-models/rf-features/tmp/

# --- Module 9: emlearn_dtype_compare.py writes one header per dtype ----------
exercises/module9-optimisation/out_dtypes/

# --- Editor / OS junk -------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp
Thumbs.db

# VS Code multi-root workspaces point at absolute paths on one machine.
*.code-workspace

# Finder duplicates ("foo copy.ipynb") — an accident, never a deliverable.
* copy.*
