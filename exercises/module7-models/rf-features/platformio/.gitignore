.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Generated by ../train_rf.py — producing these IS the exercise, and they are
# specific to each participant's own fan recordings. All three are written by
# the same run and belong together: a fan_model.h paired with someone else's
# feature_scale.h silently moves every split threshold.
src/fan_model.h
src/feature_scale.h
src/test_windows.h

# emlearn runtime: only the three headers the generated model actually needs are
# vendored (eml_trees.h -> eml_common.h -> eml_log.h, 14 KB total). `pip install
# emlearn` ships its C headers *inside the Python package*, so
# `cp -r $(python -c "import emlearn; print(emlearn.includedir)")` drags 43
# headers and 46 .py files (976 KB) into a microcontroller project. Committing
# the three keeps Module 7 buildable offline and pins the runtime to the same
# emlearn version the model generator was tested against (VERSION.txt).
#
# Same set as module6-emlearn/xor-device/lib/emlearn/. Copying extra headers
# here to experiment is expected; this rule keeps those local copies out.
lib/emlearn/*
!lib/emlearn/eml_trees.h
!lib/emlearn/eml_common.h
!lib/emlearn/eml_log.h
!lib/emlearn/VERSION.txt
