.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# xor_model.h is GENERATED by ../xor-train/train_xor.py — producing it is the
# exercise, so it must not be checked in.
include/xor_model.h

# emlearn runtime: only the three headers the generated model actually needs are
# vendored (eml_trees.h -> eml_common.h -> eml_log.h, 14 KB total). `pip install
# emlearn` ships its C headers *inside the Python package*, so
# `cp -r $(python -c "import emlearn; print(emlearn.includedir)")` drags 43
# headers and 46 .py files (976 KB) into a microcontroller project. Committing
# the three keeps Module 6 buildable offline and pins the runtime to the same
# emlearn version the model generator was tested against.
#
# Copying extra headers here to experiment (eml_net.h, eml_neighbors.h, ...) is
# expected and encouraged — see README Part 3. This rule keeps those local
# copies out of the repo.
lib/emlearn/*
!lib/emlearn/eml_trees.h
!lib/emlearn/eml_common.h
!lib/emlearn/eml_log.h
!lib/emlearn/VERSION.txt
